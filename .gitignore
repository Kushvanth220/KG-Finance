# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets)
.env*
# SQL with secrets filled in, for pasting into Supabase (never commit)
supabase/*.local.sql
!.env.local.example

# local data exports (sensitive — keep on disk, never commit)
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Local-only: contains this household's real balances
green-dot-setup.html

# Local-only: full workspace snapshots, real financial data
backups/
