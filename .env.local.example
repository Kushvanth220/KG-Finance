# Copy this file to `.env.local` for local development.
# On Vercel, add the same variables under Project Settings → Environment Variables.

# --- Supabase (required for cloud sync) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Which workspace this deployment belongs to. Every table is keyed by it.
# Leave unset to use "default".
# NEXT_PUBLIC_WORKSPACE_ID=default

# IANA time zone used for "today", month boundaries and reminders.
# NEXT_PUBLIC_TIME_ZONE=America/Chicago

# --- AI assistant (optional) --------------------------------------------------
# Gemini: text chat, tool calls and live voice.
GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_LIVE_MODEL=
# GEMINI_LIVE_VOICE=

# Second and third opinions in the assistant council (optional).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# Only for identity-linked Anthropic keys (the Console error will say so).
# ANTHROPIC_WORKSPACE_ID=

# --- Push notifications (optional) --------------------------------------------
# Generate a pair with:  npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Shared secret the Vercel cron sends to /api/push/run.
# CRON_SECRET=
